# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# Required for live evaluation. Leave unset while FAKE_LLM=1.
ANTHROPIC_API_KEY=

# Vision-capable model used for both pipeline stages.
ANTHROPIC_MODEL=claude-sonnet-5

# Set to 1 to return a canned, valid EvaluationPayload instead of calling the API.
# Lets the report renderer and full web flow run without spending tokens.
FAKE_LLM=1

# Per-LLM-call timeout, seconds.
LLM_TIMEOUT_SECONDS=120

# Ingestion guardrails.
MAX_UPLOAD_MB=30
MAX_PAGES=40

# Where uploads, rendered pages, and reports are stored.
STORAGE_DIR=storage

# SQLite database location.
DATABASE_URL=sqlite:///./data/app.db
